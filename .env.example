APP_NAME=Parking Reservation Chatbot
APP_ENV=development

# LLM / Embeddings provider (EPAM DIAL proxy, OpenAI-compatible via Azure OpenAI SDK)
DIAL_API_KEY=
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2025-04-01-preview
DIAL_CHAT_DEPLOYMENT=gpt-6-luna-2026-09-22
DIAL_EMBEDDING_DEPLOYMENT=text-embedding-3-small-1

# Vector database (static knowledge: general info, location, booking process, FAQs)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=parking_knowledge

# SQL database (dynamic data: availability, prices, working hours, reservations)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=parking_db
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=parking_pass

# MCP server (Stage 3): writes approved reservations to a file.
# MCP_AUTH_TOKEN is the shared secret the backend and MCP server both use to
# authorize the save_confirmed_reservation tool call.
MCP_HOST=localhost
MCP_PORT=8010
MCP_AUTH_TOKEN=change-me-mcp-token
MCP_REQUEST_TIMEOUT_SECONDS=5.0

# Admin notification channel (Stage 2)
ADMIN_EMAIL=

# Checkpointer / reservation file storage (local paths, relative to project root)
CHECKPOINT_DB_PATH=data/state/checkpoints.sqlite
RESERVATIONS_FILE_PATH=data/reservations/confirmed_reservations.txt
