APP_NAME=Parking Reservation Chatbot
APP_ENV=development

# LLM / Embeddings provider
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector database (static knowledge: general info, location, booking process, FAQs)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=parking_knowledge

# SQL database (dynamic data: availability, prices, working hours, reservations)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=parking_db
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=parking_pass

# MCP server (used from Stage 3 onward)
MCP_HOST=localhost
MCP_PORT=8001

# Admin notification channel (Stage 2): human-in-the-loop approval.
ADMIN_EMAIL=

# SMTP settings for emailing the administrator. Leave SMTP_HOST empty to fall back to
# logging the notification instead of sending a real email (useful for local dev/tests).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=parking-bot@example.com
SMTP_USE_TLS=true
